<form id="join" method="post" action="/register">
<h1>Join</h1>
{{{error}}}
<label for="handle">Username</label>
<input id="handle" name="handle" autocomplete="username" value="{{username}}" />
<label for="mail">Email</label>
<input id="mail" name="mail" type="email" autocomplete="email" value="{{email}}" />
<label for="secret">Password</label>
<input id="secret" name="secret" type="password" autocomplete="new-password" />
<label for="secret2">Confirm password</label>
<input id="secret2" name="secret2" type="password" autocomplete="off" />
{{{captchaBlock}}}
<label for="agree">I accept the rules</label>
<input id="agree" name="agree" type="checkbox" value="yes" />
<button type="submit" id="join-submit">Register</button>
</form>
