generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]
  modelCredentials UserModelCredential[]
  voiceCredentials UserVoiceCredential[]
  secrets          Secret[]
  mcpServers       McpServer[]
  botSections      BotSection[]
  actionApprovalRules ActionApprovalRule[]
  siteLogins          SiteLogin[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                     String   @id
  expiresAt              DateTime
  token                  String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  ipAddress              String?
  userAgent              String?
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId   String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]
  bots        Bot[]
  botSections BotSection[]
  botDeletions BotDeletion[]
  threads     Thread[]
  events      Event[]
  tasks       Task[]
  runs        Run[]
  routines    Routine[]
  scratchpadItems ScratchpadItem[]
  taughtSkills TaughtSkill[]
  connections Connection[]
  capabilities CapabilityInstall[]
  memoryDocuments MemoryDocument[]
  agentHomes  AgentHome[]
  browserProfiles BrowserProfile[]
  artifacts   Artifact[]
  usageRecords UsageRecord[]
  notificationPreferences NotificationPreference[]
  computers   Computer[]
  externalEffects ExternalEffect[]
  mcpServers   McpServer[]
  actionApprovalRules ActionApprovalRule[]
  workspaceMemoryConfig WorkspaceMemoryConfig?
  chatGroups  ChatGroup[]
  siteLogins  SiteLogin[]
  lbProjects  LbProject[]
  lbProxyLeases LbProxyLease[]
  lbHosts     LbHost[]
  lbHostAccounts LbHostAccount[]
  lbThreadCandidates LbThreadCandidate[]
  lbDrafts    LbDraft[]
  lbPlacements LbPlacement[]
  lbRuns      LbRun[]
  lbRunSteps  LbRunStep[]
  lbCaptchaEvents LbCaptchaEvent[]
  lbOperatorTickets LbOperatorTicket[]
  lbAlerts    LbAlert[]
  lbWebhookDeliveries LbWebhookDelivery[]
  lbCostEntries LbCostEntry[]
  lbInboundMail LbInboundMail[]
  lbCreditPurchases LbCreditPurchase[]

  @@unique([slug])
  @@map("organization")
}

model ActionApprovalRule {
  id              String       @id @default(cuid())
  workspaceId     String
  workspace       Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdByUser   User         @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  effect          String
  matchKind       String
  matchValue      String
  createdAt       DateTime     @default(now())

  @@unique([workspaceId, createdByUserId, effect, matchKind, matchValue])
  @@index([workspaceId, createdByUserId])
  @@map("action_approval_rules")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  createdAt      DateTime

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model DeploymentSettings {
  id                             String   @id @default("default")
  ownerUserId                    String?
  signupsEnabled                 Boolean  @default(true)
  signupAllowlist                String   @default("")
  defaultModelProvider           String?
  defaultModelId                 String?
  deploymentModelCredentialCipher String?
  computerHost                   String?
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  @@map("deployment_settings")
}

model UserModelCredential {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId  String
  provider     String
  label        String
  secretId     String
  isDefault    Boolean  @default(false)
  defaultModel String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, workspaceId])
  @@map("user_model_credentials")
}

model UserVoiceCredential {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  provider    String
  secretId    String
  isDefault   Boolean  @default(false)
  voiceId     String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, workspaceId, provider])
  @@map("user_voice_credentials")
}

model Bot {
  id             String   @id @default(cuid())
  workspaceId    String
  workspace      Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId         String
  name           String
  title          String   @default("")
  description    String   @default("")
  instructions   String   @default("")
  color          String
  notifyOnFinish Boolean  @default(true)
  pinned         Boolean  @default(false)
  sectionId      String?
  section        BotSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  archivedAt     DateTime?
  parentBotId    String?
  spawnKey       String?
  memoryScope    String?
  parent         Bot?     @relation("BotChildren", fields: [parentBotId], references: [id], onDelete: SetNull)
  children       Bot[]    @relation("BotChildren")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  thread         Thread?
  computerId     String?
  computer       Computer? @relation(fields: [computerId], references: [id], onDelete: SetNull)
  computerSwitching Boolean @default(false)
  voiceId        String?
  autoSpeak      Boolean  @default(false)
  routines       Routine[]
  scratchpadItems ScratchpadItem[]
  taughtSkills   TaughtSkill[]
  memoryDocuments MemoryDocument[]
  agentHome      AgentHome?
  browserProfile BrowserProfile?
  artifacts      Artifact[]
  usageRecords   UsageRecord[]
  tasks          Task[]
  runs           Run[]
  mcpServers     BotMcpServer[]
  groupMembers   ChatGroupMember[]
  siteLoginsCreated SiteLogin[]

  @@index([workspaceId, userId, archivedAt, pinned, updatedAt])
  @@index([sectionId])
  @@index([computerId])
  @@index([parentBotId])
  @@unique([workspaceId, spawnKey])
  @@map("bots")
}

model BotSection {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  position    Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  bots        Bot[]

  @@unique([workspaceId, userId, name])
  @@index([workspaceId, userId, position, createdAt])
  @@map("bot_sections")
}

model BotDeletion {
  id                String   @id
  workspaceId       String
  workspace         Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name              String
  deletedByUserId   String
  memoriesPreserved Boolean
  deletedAt         DateTime @default(now())

  @@index([workspaceId, deletedAt])
  @@map("bot_deletions")
}

model ChatGroup {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  members     ChatGroupMember[]
  thread      Thread?
  artifacts   Artifact[]

  @@index([workspaceId, userId, updatedAt])
  @@map("chat_groups")
}

model ChatGroupMember {
  id        String    @id @default(cuid())
  groupId   String
  group     ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  botId     String
  bot       Bot       @relation(fields: [botId], references: [id], onDelete: NoAction)
  createdAt DateTime  @default(now())

  @@unique([groupId, botId])
  @@index([botId])
  @@map("chat_group_members")
}

model Thread {
  id                      String       @id @default(cuid())
  workspaceId             String
  workspace               Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  botId                   String?      @unique
  bot                     Bot?         @relation(fields: [botId], references: [id], onDelete: Cascade)
  groupId                 String?      @unique
  group                   ChatGroup?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId                  String
  createdAt               DateTime     @default(now())
  nextEventSeq            Int          @default(0)
  nextMessageSeq          Int          @default(0)
  historyCompactedUpToSeq Int?
  historyCompactionSummary String?      @db.Text
  historyCompactionGeneration Int        @default(0)
  unread                  Boolean      @default(false)
  messages                Message[]
  events                  Event[]
  tasks                   Task[]
  runs                    Run[]

  @@index([workspaceId])
  @@map("threads")
}

model Message {
  id               String   @id @default(cuid())
  threadId         String
  thread           Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  seq              Int
  role             String
  blocks           Json
  botId            String?
  replyToMessageId String?
  replyTo          Message? @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          Message[] @relation("MessageReplies")
  runId            String?
  clientNonce      String?
  sourceRuns       Run[]    @relation("RunSourceMessage")
  createdAt        DateTime @default(now())

  @@unique([threadId, seq])
  @@unique([threadId, clientNonce])
  @@index([threadId, seq])
  @@index([replyToMessageId])
  @@map("messages")
}

model Event {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  threadId    String
  thread      Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  botId       String
  seq         Int
  type        String
  payload     Json
  runId       String?
  createdAt   DateTime @default(now())

  @@unique([threadId, seq])
  @@index([workspaceId, createdAt])
  @@index([threadId, seq])
  @@index([runId, type, seq])
  @@map("events")
}

model Task {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  botId       String
  bot         Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  threadId    String
  thread      Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId      String
  prompt      String
  status      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  runs        Run[]

  @@index([workspaceId, botId])
  @@map("tasks")
}

model Run {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  botId         String
  bot           Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  threadId      String
  thread        Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  taskId        String
  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId        String
  status        String
  trigger       String
  modelProvider String?
  modelId       String?
  error         String?
  leaseOwner    String?
  leaseFence    Int       @default(0)
  leaseExpiresAt DateTime?
  checkpoint    String?
  clientNonce   String?
  sourceMessageId String?
  sourceMessage Message?  @relation("RunSourceMessage", fields: [sourceMessageId], references: [id], onDelete: SetNull)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  attempts      Attempt[]
  effects       ExternalEffect[]
  usageRecords  UsageRecord[]

  @@unique([workspaceId, clientNonce])
  @@index([status, leaseExpiresAt])
  @@index([status, updatedAt, id])
  @@index([workspaceId, botId])
  @@index([sourceMessageId])
  @@index([threadId, status, createdAt])
  @@map("runs")
}

model Attempt {
  id         String   @id @default(cuid())
  runId      String
  run        Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  fence      Int
  status     String
  error      String?
  startedAt  DateTime @default(now())
  finishedAt DateTime?

  @@index([runId])
  @@map("attempts")
}

model ExternalEffect {
  id              String   @id @default(cuid())
  workspaceId     String
  workspace       Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runId           String
  run             Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  kind            String
  idempotencyKey  String
  status          String
  request         Json
  result          Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([idempotencyKey])
  @@index([runId, status])
  @@map("external_effects")
}

model Routine {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  botId       String
  bot         Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId      String
  name        String
  prompt      String
  cron        String
  timezone    String    @default("UTC")
  active      Boolean   @default(false)
  notify      Boolean   @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([active, nextRunAt])
  @@index([workspaceId, botId])
  @@map("routines")
}

model ScratchpadItem {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  botId       String
  bot         Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId      String
  title       String
  status      String   @default("open")
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId, botId, status])
  @@index([workspaceId, botId, updatedAt])
  @@map("scratchpad_items")
}

model SiteLogin {
  id             String       @id @default(cuid())
  workspaceId    String
  workspace      Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  host           String
  url            String?
  username       String
  secretId       String
  secret         Secret       @relation("SiteLoginSecret", fields: [secretId], references: [id], onDelete: Cascade)
  createdByBotId String?
  createdByBot   Bot?         @relation(fields: [createdByBotId], references: [id], onDelete: SetNull)
  share          String       @default("workspace")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  lbHostAccounts LbHostAccount[]

  @@unique([workspaceId, userId, host, username])
  @@index([workspaceId, userId, host])
  @@map("site_logins")
}

model TaughtSkill {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  botId       String
  bot         Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId      String
  name        String    @default("")
  goal        String
  status      String
  playbook    Json      @default("{}")
  recording   Json      @default("{\"events\":[],\"snapshots\":[]}")
  startedAt   DateTime?
  expiresAt   DateTime?
  stoppedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, botId])
  @@index([workspaceId, botId, status])
  // Partial unique index taught_skills_botId_recording_key is created in SQL:
  // one recording session per bot.
  @@map("taught_skills")
}

model Connection {
  id            String   @id @default(cuid())
  workspaceId   String
  workspace     Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId        String
  connectorId   String   @default("composio")
  provider      String
  displayName   String
  status        String
  secretId      String?
  providerRef   String?
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([workspaceId, userId, connectorId])
  @@map("connections")
}

model CapabilityInstall {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  kind        String
  name        String
  source      String
  version     String?
  digest      String?
  secretId    String?
  config      Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([workspaceId, userId])
  @@map("capability_installs")
}

model MemoryDocument {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  botId       String?
  bot         Bot?     @relation(fields: [botId], references: [id], onDelete: Cascade)
  scope       String
  path        String
  content     String
  revision    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  revisions   MemoryRevision[]

  @@unique([workspaceId, scope, botId, path])
  @@index([workspaceId, userId])
  @@map("memory_documents")
}

model MemoryRevision {
  id         String   @id @default(cuid())
  documentId String
  document   MemoryDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  revision   Int
  content    String
  sourceRunId String?
  sourceThreadId String?
  createdAt  DateTime @default(now())

  @@unique([documentId, revision])
  @@map("memory_revisions")
}

model AgentHome {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  botId       String   @unique
  bot         Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId      String
  revision    String   @default("empty")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("agent_homes")
}

model BrowserProfile {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  botId       String   @unique
  bot         Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId      String
  secretId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("browser_profiles")
}

model Computer {
  id                      String   @id @default(cuid())
  workspaceId             String
  workspace               Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId                   String
  scope                    String   @default("team")
  scopeKey                 String   @unique
  homeKey                  String   @unique
  homeRevision             String   @default("empty")
  kind                     String
  providerRef              String?
  state                    String   @default("stopped")
  controlHolder            String   @default("none")
  controlLeaseId           String?
  controlLeaseExpiresAt    DateTime?
  controlBotId             String?
  controlRunId             String?
  controlFence             Int      @default(0)
  executionRunId           String?
  executionBotId           String?
  executionLeaseExpiresAt  DateTime?
  executionFence           Int      @default(0)
  screenUrl                String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  bots                     Bot[]
  executionLeases          ComputerExecutionLease[]

  @@index([workspaceId, scope])
  @@map("computers")
}

model ComputerExecutionLease {
  id         String   @id @default(cuid())
  computerId String
  computer   Computer @relation(fields: [computerId], references: [id], onDelete: Cascade)
  botId      String
  runId      String
  fence      Int      @default(0)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([computerId, botId])
  @@index([runId])
  @@index([computerId, expiresAt])
  @@map("computer_execution_leases")
}

model Artifact {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  botId       String?
  bot         Bot?     @relation(fields: [botId], references: [id], onDelete: SetNull)
  groupId     String?
  group       ChatGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId      String
  runId       String?
  name        String
  mimeType    String
  size        Int
  hash        String
  storageKey  String
  createdAt   DateTime @default(now())

  @@index([workspaceId, botId])
  @@index([groupId])
  @@map("artifacts")
}

model UsageRecord {
  id           String   @id @default(cuid())
  workspaceId  String
  workspace    Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  botId        String?
  bot          Bot?     @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId       String
  runId        String?
  run          Run?     @relation(fields: [runId], references: [id], onDelete: SetNull)
  provider     String
  model        String
  inputTokens  Int
  outputTokens Int
  createdAt    DateTime @default(now())

  @@index([workspaceId, userId, createdAt])
  @@map("usage_records")
}

model NotificationPreference {
  id          String  @id @default(cuid())
  workspaceId String
  workspace   Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  finish      Boolean @default(true)
  help        Boolean @default(true)
  takeover    Boolean @default(true)

  @@unique([workspaceId, userId])
  @@map("notification_preferences")
}

model WorkspaceMemoryConfig {
  id                 String   @id @default(cuid())
  workspaceId        String   @unique
  workspace          Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId             String
  provider           String
  settings           Json
  secretId           String   @unique
  secret             Secret   @relation(fields: [secretId], references: [id], onDelete: Cascade)
  defaultMemoryScope String   @default("isolated")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("workspace_memory_configs")
}

model Secret {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  kind        String
  ciphertext  String
  createdAt   DateTime @default(now())
  mcpServers  McpServer[]
  workspaceMemoryConfig WorkspaceMemoryConfig?
  siteLogins  SiteLogin[] @relation("SiteLoginSecret")
  lbCaptchaProjects LbProject[] @relation("LbProjectCaptchaSecret")
  lbProxyLeases LbProxyLease[] @relation("LbProxyLeaseEndpointSecret")
  lbWebhookProjects LbProject[] @relation("LbProjectWebhookSecret")

  @@index([userId, workspaceId])
  @@map("secrets")
}

model McpServer {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  description String   @default("")
  transport   String
  endpoint    String?
  command     String?
  args        Json     @default("[]")
  env         Json     @default("{}")
  headers     Json     @default("{}")
  secretId    String?
  secret      Secret?  @relation(fields: [secretId], references: [id], onDelete: SetNull)
  enabled     Boolean  @default(true)
  revision    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  assignments BotMcpServer[]
  oauthSessions McpOAuthSession[]

  @@unique([workspaceId, userId, slug])
  @@index([workspaceId, userId])
  @@map("mcp_servers")
}

model McpOAuthSession {
  id          String   @id
  workspaceId String
  userId      String
  serverId    String
  server      McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  endpoint    String
  redirectUri String
  oauthCiphertext String
  createdAt   DateTime @default(now())

  @@index([workspaceId, userId, createdAt])
  @@map("mcp_oauth_sessions")
}

model BotMcpServer {
  id          String   @id @default(cuid())
  workspaceId String
  botId       String
  bot         Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  serverId    String
  server      McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  userId      String
  allowAllTools Boolean @default(true)
  allowedTools Json    @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([botId, serverId])
  @@index([workspaceId, userId, botId])
  @@map("bot_mcp_servers")
}

// Link Builder. Status columns are Strings whose allowed values come from
// @rakazo/contracts (link-builder.ts) and are enforced by CHECK constraints in
// migrations/20261005120000_link_builder. Secrets are referenced by id only.

model LbProject {
  id                       String              @id @default(cuid())
  workspaceId              String
  workspace                Organization        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByUserId          String
  name                     String
  slug                     String
  status                   String              @default("draft")
  brandName                String
  allowedDomains           String[]            @default([])
  persona                  Json?
  mailboxId                String?
  mailboxAddress           String?
  captchaSecretId          String?
  captchaSecret            Secret?             @relation("LbProjectCaptchaSecret", fields: [captchaSecretId], references: [id], onDelete: SetNull)
  captchaLowBalanceCredits Int                 @default(500)
  quotas                   Json?
  schedule                 Json                @default("{\"timezone\":\"Europe/Berlin\",\"weekdaysOnly\":true,\"window\":{\"start\":\"09:00\",\"end\":\"22:00\"},\"overtimeUntilLiveMet\":false,\"hardStopHour\":24}")
  topicLanes               Json                @default("[]")
  markets                  Json                @default("[{\"country\":\"DE\",\"language\":\"de\",\"locale\":\"de-DE\",\"timezoneId\":\"Europe/Berlin\"}]")
  marketPolicy             String              @default("primary_first")
  disclosureMode           String              @default("undisclosed_persona")
  responsibilityAck        Json?
  linkRatio                Json                @default("{\"links\":1,\"posts\":3}")
  proxyPolicy              String              @default("static_isp_per_persona")
  countNofollow            Boolean             @default(true)
  targets                  Json                @default("[]")
  facts                    String[]            @default([])
  denyHosts                String[]            @default([])
  preferHosts              String[]            @default([])
  warmup                   Json                @default("{\"minPostsBeforeLink\":3,\"minAccountAgeHours\":24}")
  spamRetry                Json                @default("{\"maxRetries\":1,\"sentences\":[\"Die Registrierung ist wegen Spamschutzmaßnahmen fehlgeschlagen.\",\"No soup for you!\"]}")
  content                  Json                @default("{\"toneNotes\":\"\",\"bannedClaims\":[],\"maxReplyChars\":1200}")
  operator                 Json                @default("{\"parkedHostTtlHours\":48,\"ticketTtlHours\":24,\"onExpire\":\"skip\",\"channels\":[\"push\",\"email\"]}")
  webhookUrl               String?
  webhookSecretId          String?
  webhookSecret            Secret?             @relation("LbProjectWebhookSecret", fields: [webhookSecretId], references: [id], onDelete: SetNull)
  /// Last Captell balance read by the scheduled check. Not a secret.
  lastCaptchaBalance       Int?
  /// Set by the discovery pass. Null until the first run after the project starts.
  lastDiscoveredAt         DateTime?
  archivedAt               DateTime?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  proxyLeases              LbProxyLease[]
  hosts                    LbHost[]
  hostAccounts             LbHostAccount[]
  threadCandidates         LbThreadCandidate[]
  drafts                   LbDraft[]
  placements               LbPlacement[]
  runs                     LbRun[]
  captchaEvents            LbCaptchaEvent[]
  operatorTickets          LbOperatorTicket[]
  alerts                   LbAlert[]
  webhookDeliveries        LbWebhookDelivery[]
  costEntries              LbCostEntry[]
  inboundMail              LbInboundMail[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, status])
  @@index([captchaSecretId])
  @@index([webhookSecretId])
  @@map("lb_projects")
}

// One sticky exit IP per persona and country: partial unique index
// "lb_proxy_leases_one_active_per_project_country" in the link_builder migration.
model LbProxyLease {
  id               String       @id @default(cuid())
  workspaceId      String
  workspace        Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId        String
  project          LbProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  provider         String
  providerLeaseId  String
  country          String
  stickyKey        String
  kind             String       @default("static_isp")
  endpointSecretId String?
  endpointSecret   Secret?      @relation("LbProxyLeaseEndpointSecret", fields: [endpointSecretId], references: [id], onDelete: SetNull)
  status           String       @default("active")
  leasedAt         DateTime     @default(now())
  renewsAt         DateTime?
  releasedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([workspaceId, projectId, status])
  @@index([status, renewsAt])
  @@index([endpointSecretId])
  @@map("lb_proxy_leases")
}

model LbHost {
  id                  String              @id @default(cuid())
  workspaceId         String
  workspace           Organization        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId           String
  project             LbProject           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  registrableDomain   String
  homepageUrl         String
  platform            String              @default("unknown")
  platformVersionHint String?
  language            String
  country             String
  /// Market tag copied from the market that discovered this host. M6 reads it for the session.
  locale              String              @default("")
  timezoneId          String              @default("")
  topicTags           String[]            @default([])
  qualityScore        Float               @default(0)
  hrefForNewMembers   String              @default("unknown")
  relDefault          String              @default("unknown")
  signatureLinks      Boolean             @default(false)
  minPostsForLinks    Int?
  registerUrl         String?
  captchaType         String?
  engineHint          String?
  status              String              @default("discovered")
  parkedFrom          String?
  statusReason        String?
  lastProbeAt         DateTime?
  notes               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  accounts            LbHostAccount[]
  threadCandidates    LbThreadCandidate[]
  placements          LbPlacement[]
  currentRuns         LbRun[]
  captchaEvents       LbCaptchaEvent[]
  operatorTickets     LbOperatorTicket[]

  @@unique([workspaceId, projectId, registrableDomain])
  @@index([workspaceId, projectId, status])
  @@index([workspaceId, projectId, country, status])
  @@map("lb_hosts")
}

// One account per host and persona; v1 has one persona per project.
model LbHostAccount {
  id              String        @id @default(cuid())
  workspaceId     String
  workspace       Organization  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId       String
  project         LbProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  hostId          String
  host            LbHost        @relation(fields: [hostId], references: [id], onDelete: Cascade)
  username        String
  siteLoginId     String?
  siteLogin       SiteLogin?    @relation(fields: [siteLoginId], references: [id], onDelete: SetNull)
  emailVerifiedAt DateTime?
  adminApprovedAt DateTime?
  postCount       Int           @default(0)
  linkPostCount   Int           @default(0)
  firstPostAt     DateTime?
  lastPostAt      DateTime?
  signatureSetAt  DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  placements      LbPlacement[]

  @@unique([hostId])
  @@index([workspaceId, projectId])
  @@index([siteLoginId])
  @@map("lb_host_accounts")
}

model LbThreadCandidate {
  id             String       @id @default(cuid())
  workspaceId    String
  workspace      Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId      String
  project        LbProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  hostId         String
  host           LbHost       @relation(fields: [hostId], references: [id], onDelete: Cascade)
  url            String
  title          String
  excerpt        String       @default("")
  lastActivityAt DateTime?
  replyCount     Int          @default(0)
  relevance      Float        @default(0)
  laneId         String?
  openQuestion   Boolean      @default(false)
  status         String       @default("candidate")
  rejectReason   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  drafts         LbDraft[]

  @@unique([hostId, url])
  @@index([workspaceId, projectId, status])
  @@map("lb_thread_candidates")
}

model LbDraft {
  id                String            @id @default(cuid())
  workspaceId       String
  workspace         Organization      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId         String
  project           LbProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  threadCandidateId String
  threadCandidate   LbThreadCandidate @relation(fields: [threadCandidateId], references: [id], onDelete: Cascade)
  modelLane         String
  modelId           String
  body              String
  linkSlot          String            @default("none")
  targetUrl         String?
  anchorText        String?
  confidence        Float?
  qualityChecks     Json              @default("{}")
  status            String            @default("drafted")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  placements        LbPlacement[]

  @@index([threadCandidateId])
  @@index([workspaceId, projectId, status])
  @@map("lb_drafts")
}

// "One counted LIVE link per host forever" is the partial unique index
// "lb_placements_one_counted_per_host" (workspaceId, projectId, hostId) WHERE counted,
// created in the link_builder migration; Prisma cannot express it.
model LbPlacement {
  id                 String        @id @default(cuid())
  workspaceId        String
  workspace          Organization  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId          String
  project            LbProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  hostId             String
  host               LbHost        @relation(fields: [hostId], references: [id], onDelete: Cascade)
  hostAccountId      String
  hostAccount        LbHostAccount @relation(fields: [hostAccountId], references: [id], onDelete: Cascade)
  draftId            String?
  draft              LbDraft?      @relation(fields: [draftId], references: [id], onDelete: SetNull)
  threadUrl          String
  postUrl            String
  targetUrl          String
  anchorText         String
  rel                String[]      @default([])
  indexable          Boolean       @default(true)
  status             String        @default("pending")
  counted            Boolean       @default(false)
  verifiedAt         DateTime?
  verifyMethod       String?
  snapshotArtifactId String?
  nextVerifyAt       DateTime?
  /// How many scheduled checks have completed. The next deadline is offset `verifyCount`.
  verifyCount        Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([workspaceId, projectId, status])
  @@index([hostId])
  @@index([hostAccountId])
  @@index([draftId])
  @@index([status, nextVerifyAt])
  @@map("lb_placements")
}

model LbRun {
  id              String             @id @default(cuid())
  workspaceId     String
  workspace       Organization       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId       String
  project         LbProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Local calendar date in the project time zone, YYYY-MM-DD.
  date            String
  status          String             @default("queued")
  newToday        Int                @default(0)
  liveToday       Int                @default(0)
  liveWeek        Int                @default(0)
  uniqueHosts     Int                @default(0)
  currentHostId   String?
  currentHost     LbHost?            @relation(fields: [currentHostId], references: [id], onDelete: SetNull)
  currentUrl      String?
  lastAction      String?
  lastError       String?
  whyNot          Json?
  leaseOwner      String?
  leaseFence      Int                @default(0)
  leaseExpiresAt  DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  steps           LbRunStep[]
  captchaEvents   LbCaptchaEvent[]
  operatorTickets LbOperatorTicket[]

  @@unique([projectId, date])
  @@index([workspaceId, projectId])
  @@index([status, leaseExpiresAt])
  @@index([currentHostId])
  @@map("lb_runs")
}

// Append-only; idempotent per (runId, stepIndex).
model LbRunStep {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runId       String
  run         LbRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepIndex   Int
  kind        String
  hostId      String?
  input       Json         @default("{}")
  outcome     Json         @default("{}")
  error       String?
  artifactIds String[]     @default([])
  costs       Json         @default("{\"credits\":0,\"tokens\":0,\"bytes\":0,\"ms\":0}")
  startedAt   DateTime     @default(now())
  finishedAt  DateTime?
  createdAt   DateTime     @default(now())

  @@unique([runId, stepIndex])
  @@index([workspaceId, runId])
  @@map("lb_run_steps")
}

model LbCaptchaEvent {
  id                 String       @id @default(cuid())
  workspaceId        String
  workspace          Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId          String
  project            LbProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  hostId             String?
  host               LbHost?      @relation(fields: [hostId], references: [id], onDelete: SetNull)
  runId              String?
  run                LbRun?       @relation(fields: [runId], references: [id], onDelete: SetNull)
  type               String
  door               String
  buttonTextObserved String?
  humanCheckboxState String?
  imageGridOpen      Boolean      @default(false)
  siteKeyFound       Boolean      @default(false)
  attempt            Int          @default(1)
  creditsCharged     Int          @default(0)
  balanceAfter       Int?
  outcome            String
  helperVersion      String?
  /** Solver task id. Never a token, an answer or an image. */
  taskId             String?
  createdAt          DateTime     @default(now())

  @@index([workspaceId, projectId, createdAt])
  @@index([hostId])
  @@index([runId])
  @@map("lb_captcha_events")
}

model LbOperatorTicket {
  id               String       @id @default(cuid())
  workspaceId      String
  workspace        Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId        String
  project          LbProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  hostId           String
  host             LbHost       @relation(fields: [hostId], references: [id], onDelete: Cascade)
  runId            String?
  run              LbRun?       @relation(fields: [runId], references: [id], onDelete: SetNull)
  reason           String
  screenUrl        String?
  note             String?
  status           String       @default("open")
  resolvedByUserId String?
  resolvedAt       DateTime?
  expiresAt        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([workspaceId, projectId, status])
  @@index([hostId])
  @@index([runId])
  @@index([status, expiresAt])
  @@map("lb_operator_tickets")
}

model LbAlert {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String
  project     LbProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind        String
  dedupeKey   String
  message     String
  payload     Json         @default("{}")
  createdAt   DateTime     @default(now())
  deliveries  LbWebhookDelivery[]

  @@unique([projectId, dedupeKey])
  @@index([workspaceId, projectId, createdAt])
  @@map("lb_alerts")
}

model LbWebhookDelivery {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId     String
  project       LbProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  alertId       String
  alert         LbAlert   @relation(fields: [alertId], references: [id], onDelete: Cascade)
  attempt       Int
  status        String
  statusCode    Int?
  nextAttemptAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([projectId, createdAt])
  @@index([status, nextAttemptAt])
  @@map("lb_webhook_deliveries")
}

model LbCostEntry {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String
  project     LbProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runId       String?
  kind        String
  lane        String?
  quantity    Int
  sourceKey   String       @unique
  occurredAt  DateTime
  createdAt   DateTime     @default(now())

  @@index([workspaceId, projectId, occurredAt])
  @@map("lb_cost_entries")
}

// A purchased package is a settled live charge, or an explicit allowance row.
// Stub checkout attempts are not stored. Allowance rows do not add credits.
model LbCreditPurchase {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  packageId   String
  credits     Int
  priceCents  Int
  currency    String
  billing     String
  chargeId    String?      @unique
  createdAt   DateTime     @default(now())

  @@index([workspaceId, createdAt])
  @@map("lb_credit_purchases")
}

model LbInboundMail {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String
  project     LbProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inboxId     String
  eventId     String?
  fromAddress String
  subject     String
  textBody    String
  htmlBody    String?
  receivedAt  DateTime
  createdAt   DateTime     @default(now())

  @@unique([projectId, eventId])
  @@index([inboxId, receivedAt])
  @@map("lb_inbound_mail")
}
