{
  "name": "@rakazo/linkbuilder-browser",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "development": "./src/testing.ts",
      "default": "./src/testing.ts"
    },
    "./dist/rakazo-lb-browser.cjs": "./dist/rakazo-lb-browser.cjs"
  },
  "bin": {
    "rakazo-lb-browser": "./src/runner-cli.ts"
  },
  "scripts": {
    "build": "pnpm run bundle:runner",
    "bundle:runner": "node scripts/bundle-runner.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. packages/linkbuilder-browser/src"
  },
  "dependencies": {
    "@rakazo/adapter-kit": "workspace:*",
    "@rakazo/linkbuilder-core": "workspace:*",
    "patchright": "^1.63.0",
    "playwright": "^1.55.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@rakazo/adapters": "workspace:*",
    "esbuild": "0.28.2",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
