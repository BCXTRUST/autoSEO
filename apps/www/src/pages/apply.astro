---
import ApplyForm from "../components/ApplyForm.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Apply · AutoSEO.run"
  description="Apply for AutoSEO.run early access. Tell us about your campaign research and controlled contribution workflow. We schedule a fit call only when there is a match."
>
  <div class="container">
    <Header />
    <main id="main" class="apply-page">
      <p class="eyebrow">Early access</p>
      <h1>Tell us the work. We will tell you if we fit.</h1>
      <p class="lead lead--left">
        This is an application, not a checkout. Tell us how you research opportunities, review
        contributions, and keep external actions under control. We read each application before offering a call.
      </p>
      <ApplyForm idPrefix="page-apply" />
    </main>
    <Footer />
  </div>
</BaseLayout>
