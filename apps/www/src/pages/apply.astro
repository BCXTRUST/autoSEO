---
import ApplyForm from "../components/ApplyForm.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Apply · AutoSEO.run"
  description="Apply for AutoSEO.run early access. A link building tool that posts on real forums. We take a fit call only if it looks like a match."
>
  <div class="container">
    <Header />
    <main id="main" class="apply-page">
      <a class="button button--secondary button--small back-link" href="/">Back</a>
      <p class="eyebrow">Early access</p>
      <h1>Tell us the forums. We will tell you if we fit.</h1>
      <p class="lead lead--left">
        This is an application, not a checkout. It is for forum links, not articles. If you asked
        for a call, we send a slot only after we read this and think we can help.
      </p>
      <ApplyForm idPrefix="page-apply" />
    </main>
    <Footer />
  </div>
</BaseLayout>
