---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { CONTACT_EMAIL } from "../site";
---

<BaseLayout title="Support · AutoSEO.run" description="Get help with AutoSEO.run early access and the hosted desk.">
  <div class="container">
    <Header />
    <main id="main" class="privacy-copy">
      <a class="button button--secondary button--small back-link" href="/">Back</a>
      <h1>Support</h1>
      <p>
        For early access and the hosted product, email{" "}
        <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. Include the email you applied with and what
        you expected. Do not send passwords, API keys, or mailbox credentials.
      </p>
      <h2>Applications</h2>
      <p>
        We review every application. If you have not heard back, it is either still in review or not a match —
        we do not drip “you’re on the list” mail to people we cannot help.
      </p>
    </main>
    <Footer />
  </div>
</BaseLayout>
