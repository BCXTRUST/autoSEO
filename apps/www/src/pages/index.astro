---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_DESCRIPTION, SITE_NAME, SITE_URL } from "../site";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE_URL}/#website`,
      url: `${SITE_URL}/`,
      name: SITE_NAME,
      description: SITE_DESCRIPTION,
      inLanguage: "en",
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${SITE_URL}/#software`,
      name: SITE_NAME,
      url: SITE_URL,
      description: SITE_DESCRIPTION,
      applicationCategory: "BusinessApplication",
      applicationSubCategory: "Campaign workflow for SEO and GEO",
      operatingSystem: "Web",
      offers: {
        "@type": "Offer",
        availability: "https://schema.org/LimitedAvailability",
        url: `${SITE_URL}/apply/`,
      },
    },
  ],
};
---

<BaseLayout title="AutoSEO.run — campaign workflows for SEO and GEO" description={SITE_DESCRIPTION} {structuredData}>
  <div class="container">
    <Header />

    <main id="main">
      <section class="hero">
        <div class="hero__copy">
          <p class="eyebrow"><span class="eyebrow__dot"></span> Campaign operations for SEO + GEO</p>
          <h1>Turn search work into a <span class="accent">reviewable workflow.</span></h1>
          <p class="lead">
            Set up a campaign, find relevant opportunities, and move useful contributions through review.
            AutoSEO keeps the work and its status in one place. Controlled actions use explicitly supported,
            authorized connections, and you decide what goes live.
          </p>
          <div class="hero__actions">
            <button class="button button--primary" type="button" data-get-started-open data-apply-intent="apply">
              Apply for early access <span class="external-icon" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M5 11 11 5M5 5h6v6" /></svg></span>
            </button>
            <a class="button button--secondary" href="https://app.autoseo.run/app">Open the workspace</a>
          </div>
          <p class="hero__note">Publishing and sending stay behind your approval on supported connections.</p>
        </div>

        <figure class="workspace-preview" aria-labelledby="preview-title">
          <div class="preview-topline">
            <span class="preview-brand"><span class="preview-brand__mark">A</span> AutoSEO <span class="preview-brand__muted">/ workspace</span></span>
            <span class="preview-pill"><span></span> Illustrative preview</span>
          </div>
          <div class="preview-layout">
            <aside class="preview-rail" aria-hidden="true">
              <div class="preview-rail__logo">A</div>
              <span class="preview-rail__item preview-rail__item--active"><i></i> Overview</span>
              <span class="preview-rail__item"><i></i> Campaigns</span>
              <span class="preview-rail__item"><i></i> Opportunities</span>
              <span class="preview-rail__item"><i></i> Activity</span>
              <div class="preview-rail__bottom"><span></span><span></span></div>
            </aside>
            <div class="preview-main">
              <div class="preview-heading">
                <div>
                  <p class="preview-kicker">Campaign overview</p>
                  <h2 id="preview-title">SaaS growth campaign</h2>
                </div>
                <span class="preview-status"><i></i> In progress</span>
              </div>
              <div class="preview-workflow" aria-label="Workflow stages">
                <div class="preview-stage preview-stage--done"><span>01</span><b>Setup</b><small>Brief saved</small></div>
                <div class="preview-stage preview-stage--done"><span>02</span><b>Opportunities</b><small>Ready to review</small></div>
                <div class="preview-stage preview-stage--current"><span>03</span><b>Contributions</b><small>Needs approval</small></div>
                <div class="preview-stage"><span>04</span><b>Verification</b><small>After publish</small></div>
              </div>
              <div class="preview-columns">
                <section class="preview-card preview-card--review" aria-label="Contribution awaiting review">
                  <div class="preview-card__top"><span class="preview-card__label">REVIEW QUEUE</span><span class="preview-card__more">•••</span></div>
                  <p class="preview-item-title">Practical guide to product-led onboarding</p>
                  <p class="preview-item-meta">Content draft <span>·</span> Source notes attached</p>
                  <div class="preview-card__footer"><span class="preview-review"><i></i> Ready for your review</span><span class="preview-open">View draft <b aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M5 11 11 5M5 5h6v6" /></svg></b></span></div>
                </section>
                <section class="preview-card preview-card--activity" aria-label="Recent workflow activity">
                  <div class="preview-card__top"><span class="preview-card__label">RECENT ACTIVITY</span><span class="preview-card__more">•••</span></div>
                  <div class="preview-event"><span class="preview-event__icon preview-event__icon--cyan" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M15.8 7A6.2 6.2 0 0 0 5 4.2L3.5 5.8M3.5 2.8v3h3M4.2 13A6.2 6.2 0 0 0 15 15.8l1.5-1.6m0 3v-3h-3" /></svg></span><span><b>Research needs another pass</b><small>Retry or defer this task</small></span></div>
                  <div class="preview-event"><span class="preview-event__icon preview-event__icon--violet" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="m4 10 4 4 8-8" /></svg></span><span><b>Placement check completed</b><small>Verification recorded</small></span></div>
                </section>
              </div>
              <p class="preview-caption">Example workspace state. Campaign details and activity shown are illustrative.</p>
            </div>
          </div>
        </figure>
      </section>

      <section class="workflow section" id="workflow">
        <div class="section-intro">
          <p class="eyebrow">A clear operating loop</p>
          <h2 class="section-heading">From campaign brief to verified work.</h2>
          <p class="section-copy">Keep research, decisions, and outcomes connected. When a task needs another pass, retry it or defer it for later.</p>
        </div>
        <div class="workflow-grid">
          <article class="workflow-card">
            <span class="workflow-card__number">01</span>
            <span class="workflow-card__icon workflow-card__icon--cyan" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 4h14v16H5zM8 8h8M8 12h5M8 16h8" /></svg></span>
            <h3>Set up a campaign</h3>
            <p>Define the audience, goals, constraints, and what a useful contribution looks like.</p>
          </article>
          <article class="workflow-card">
            <span class="workflow-card__number">02</span>
            <span class="workflow-card__icon workflow-card__icon--violet" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="10.8" cy="10.8" r="6.3"/><path d="m15.5 15.5 4.2 4.2" /></svg></span>
            <h3>Review opportunities</h3>
            <p>Surface relevant pages and prospects, with context to help you decide what deserves attention.</p>
          </article>
          <article class="workflow-card">
            <span class="workflow-card__number">03</span>
            <span class="workflow-card__icon workflow-card__icon--cyan" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m12 3 1.6 6.2L20 12l-6.4 1.6L12 20l-1.6-6.4L4 12l6.4-2.8L12 3Z"/><path d="m19 3 .7 2.3L22 6l-2.3.7L19 9l-.7-2.3L16 6l2.3-.7L19 3Z"/></svg></span>
            <h3>Approve contributions</h3>
            <p>Check drafts and outreach before anything is published or sent. Your review stays in the loop.</p>
          </article>
          <article class="workflow-card">
            <span class="workflow-card__number">04</span>
            <span class="workflow-card__icon workflow-card__icon--violet" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 17 18 6M9 6h9v9" /></svg></span>
            <h3>Track activity</h3>
            <p>See what changed, retry a task, defer it, and verify work after it goes live.</p>
          </article>
        </div>
      </section>

      <section class="control-panel section" id="control">
        <div class="control-panel__copy">
          <p class="eyebrow">Human review, built in</p>
          <h2 class="section-heading">Useful automation. Clear decisions.</h2>
          <p class="section-copy">AutoSEO helps move campaign work along and makes the next step visible. Controlled publishing and outreach require an explicitly supported, authorized connection, and each action waits for your approval.</p>
          <ul class="feature-list">
            <li><span aria-hidden="true"><svg viewBox="0 0 16 16"><path d="m3 8 3.2 3.2L13 4.5" /></svg></span> Review a contribution before it ships</li>
            <li><span aria-hidden="true"><svg viewBox="0 0 16 16"><path d="m3 8 3.2 3.2L13 4.5" /></svg></span> Retry when a step needs another attempt</li>
            <li><span aria-hidden="true"><svg viewBox="0 0 16 16"><path d="m3 8 3.2 3.2L13 4.5" /></svg></span> Defer work that can wait</li>
            <li><span aria-hidden="true"><svg viewBox="0 0 16 16"><path d="m3 8 3.2 3.2L13 4.5" /></svg></span> Check whether published work is live</li>
          </ul>
        </div>
        <div class="control-card" aria-label="Illustration of review controls">
          <div class="control-card__header"><span>Contribution review</span><span class="control-card__badge">Awaiting approval</span></div>
          <div class="control-card__body">
            <span class="control-card__type">OUTREACH DRAFT</span>
            <h3>A relevant reason to reach out</h3>
            <p>Review the page context and message, then choose what happens next.</p>
            <div class="control-card__actions"><span>Defer</span><span>Request changes</span><span class="control-card__approve">Approve to send</span></div>
          </div>
          <p class="control-card__foot"><span></span> Sending stays behind your approval.</p>
        </div>
      </section>

      <section class="access-band" id="access">
        <div>
          <p class="eyebrow">Early access</p>
          <h2>Bring your real workflow.</h2>
          <p>Apply with the work you want to improve. We review each application and follow up if there is a fit.</p>
        </div>
        <div class="access-band__actions">
          <button class="button button--primary" type="button" data-get-started-open data-apply-intent="apply">Apply for early access <span class="external-icon" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M5 11 11 5M5 5h6v6" /></svg></span></button>
          <button class="button button--secondary" type="button" data-get-started-open data-apply-intent="call">Book a fit call</button>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>
