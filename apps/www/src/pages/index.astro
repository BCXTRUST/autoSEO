---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  SITE_DESCRIPTION,
  SITE_NAME,
  SITE_URL,
} from "../site";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE_URL}/#website`,
      url: `${SITE_URL}/`,
      name: SITE_NAME,
      description: SITE_DESCRIPTION,
      inLanguage: "en",
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${SITE_URL}/#software`,
      name: SITE_NAME,
      url: SITE_URL,
      description: SITE_DESCRIPTION,
      applicationCategory: "BusinessApplication",
      applicationSubCategory: "Forum link building",
      operatingSystem: "Web",
      offers: {
        "@type": "Offer",
        availability: "https://schema.org/LimitedAvailability",
        url: `${SITE_URL}/apply/`,
      },
    },
  ],
};
---

<BaseLayout title="AutoSEO.run — the link building tool that posts on the forum" description={SITE_DESCRIPTION} {structuredData}>
  <div class="container">
    <Header />

    <main id="main">
      <section class="hero">
        <p class="pill">
          <span class="pill__badge">Early access</span>
          <span>Forum links. You watch the computer.</span>
        </p>
        <h1>The link building tool that <span class="accent">posts on the forum</span>.</h1>
        <p class="lead">
          Most tools find an email and wait for a reply. This one opens a real forum, registers, and
          posts. You can watch the screen. If the site admin has to approve, it waits. It does not
          call the link live until the post is up.
        </p>
        <div class="hero__actions">
          <button class="button button--primary" type="button" data-get-started-open data-apply-intent="apply">
            Apply for early access
          </button>
          <button class="button button--secondary" type="button" data-get-started-open data-apply-intent="call">
            Book a fit call
          </button>
        </div>
        <p class="hero__note">Not an outreach inbox. Not a guest-post marketplace. Not an article writer.</p>

        <div class="console" aria-hidden="true">
          <div class="console__bar">
            <span class="console__url">autoseo.run · link builder</span>
            <span class="console__flag">you can watch</span>
          </div>
          <div class="console__body">
            <article class="lane">
              <header class="lane__head">
                <span class="lane__tag lane__tag--links">Today</span>
                <span class="lane__title">0/1 links placed</span>
              </header>
              <ol class="lane__steps">
                <li><span>Find</span><b>done</b></li>
                <li class="is-active"><span>Register</span><b>now</b></li>
                <li><span>Wait</span><b>—</b></li>
                <li><span>Post</span><b>—</b></li>
              </ol>
              <div class="lane__card">
                <p class="lane__card-kicker">All time</p>
                <p class="lane__card-title">6 registered · 0 posted · 3 skipped</p>
                <p class="lane__card-meta">Those counts are every forum so far. The 0/1 is today. It is not a week.</p>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section id="different" class="section">
        <div class="section-intro">
          <div class="eyebrow">Why this is a different tool</div>
          <h2 class="section-heading">Three jobs get called “link building.” Only one of them posts.</h2>
          <p class="section-copy">
            The category is crowded. The work is not the same. Pitch software, marketplaces, and a
            browser that joins the forum are three different products.
          </p>
        </div>
        <div class="offers-grid offers-grid--three">
          <article class="offer-card">
            <p class="offer-card__kicker">Outreach inboxes</p>
            <h3>They send a pitch.</h3>
            <p class="offer-card__copy">
              Pitchbox, BuzzStream, and Respona find a person and help you email them. The link
              exists only if that person replies and publishes. Useful for guest posts. Useless if
              the plan is to post on the forum yourself.
            </p>
          </article>
          <article class="offer-card">
            <p class="offer-card__kicker">Marketplaces</p>
            <h3>They sell a URL.</h3>
            <p class="offer-card__copy">
              You pay for a placement on someone else’s site. You do not see the post being made.
              Google tells sites not to pass ranking credit for links that were paid for. We do not
              sell that inventory, and we do not buy it.
            </p>
          </article>
          <article class="offer-card">
            <p class="offer-card__kicker">This tool</p>
            <h3>It posts on the forum.</h3>
            <p class="offer-card__copy">
              A computer opens the site, registers, and writes the post. You watch. One live link
              per site. A daily cap, so it does not flood one community. A captcha it cannot solve
              is skipped, not forced.
            </p>
          </article>
        </div>
      </section>

      <section id="work" class="section">
        <div class="section-intro">
          <div class="eyebrow">How a placement happens</div>
          <h2 class="section-heading">Find. Register. Wait. Post.</h2>
          <p class="section-copy">
            Nothing is counted as live while it is still waiting on a person or a site admin.
          </p>
        </div>
        <ol class="steps">
          <li>
            <span>01</span>
            <h3>Find a real forum</h3>
            <p>It searches for communities about the topic. A parked domain or a site it cannot join is skipped.</p>
          </li>
          <li>
            <span>02</span>
            <h3>Register</h3>
            <p>It fills the form on the site. If a confirmation email is required, it waits for that email.</p>
          </li>
          <li>
            <span>03</span>
            <h3>Wait for the site admin</h3>
            <p>Some forums approve the account or the post by hand. It checks again later. It does not pretend the link is up.</p>
          </li>
          <li>
            <span>04</span>
            <h3>Post, while you watch</h3>
            <p>You can open the computer and see the page. You approve a draft when one is waiting. Then it posts.</p>
          </li>
        </ol>
      </section>

      <section class="section">
        <div class="not-grid">
          <article>
            <h2>What you get</h2>
            <ul>
              <li>A link on a real forum, placed by the tool</li>
              <li>A screen you can watch while it works</li>
              <li>A clear wait when a site admin has to approve</li>
              <li>All-time counts, and a separate number for today</li>
              <li>One live link per site, inside a daily cap</li>
            </ul>
          </article>
          <article>
            <h2>What this is not</h2>
            <ul>
              <li>An article writer or a content calendar</li>
              <li>An email sequence that hopes an editor replies</li>
              <li>A guest-post package sold by domain rating</li>
              <li>A promise that a waiting post is already live</li>
              <li>A flood of the same forum</li>
            </ul>
          </article>
        </div>
      </section>

      <section id="match" class="section">
        <div class="section-intro">
          <div class="eyebrow">Who we take</div>
          <h2 class="section-heading">Early access is for desks that want the post, not a pitch.</h2>
          <p class="section-copy">
            If the job is “publish 50 articles” or “buy 50 links and send a screenshot,” this is the
            wrong tool.
          </p>
        </div>
        <div class="match-grid">
          <article class="match-card match-card--yes">
            <h3>A match</h3>
            <ul>
              <li>Agencies that need forum links a client can open</li>
              <li>Operators who will watch the first posts</li>
              <li>Desks that already refuse marketplace inventory</li>
              <li>Teams that want a daily cap, not a blast</li>
            </ul>
          </article>
          <article class="match-card match-card--no">
            <h3>Not a match</h3>
            <ul>
              <li>Shopping a DR package</li>
              <li>Wanting an AI blog instead of links</li>
              <li>Needing it live tomorrow with no site and no rules</li>
              <li>Measuring success only as a link count</li>
            </ul>
          </article>
        </div>
      </section>

      <section id="apply" class="stats-band apply-band">
        <div>
          <h2>Apply. If we match, we talk.</h2>
          <p>
            Twenty minutes. No deck. We look at the forums you want, what you will not post, and
            whether this desk should run it.
          </p>
          <div class="cta-actions">
            <a class="button button--primary" href="/apply/">Open the application</a>
            <button class="button button--secondary" type="button" data-get-started-open data-apply-intent="call">
              Book a fit call
            </button>
          </div>
        </div>
        <div class="stats-grid">
          <div>
            <div class="stat-value">Forum</div>
            <div class="stat-label">It joins the site and posts</div>
          </div>
          <div>
            <div class="stat-value">Watch</div>
            <div class="stat-label">The computer is on screen</div>
          </div>
          <div>
            <div class="stat-value">Wait</div>
            <div class="stat-label">Admin approval stays a wait</div>
          </div>
          <div>
            <div class="stat-value">Today</div>
            <div class="stat-label">A daily cap, not a hidden week</div>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>
