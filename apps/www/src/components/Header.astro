---
import Logo from "./Logo.astro";

const NAV_LINKS = [
  { href: "/#workflow", label: "Workflow" },
  { href: "/#control", label: "Review & control" },
  { href: "/support/", label: "Support" },
];
---

<header class="site-header">
  <div class="site-header__left">
    <Logo />
    <nav class="site-nav" aria-label="Primary">
      {NAV_LINKS.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>
  </div>
  <div class="site-header__right">
    <div class="site-header__cta">
      <a class="site-header__app" href="https://app.autoseo.run/app">Open workspace <span class="external-icon" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M5 11 11 5M5 5h6v6" /></svg></span></a>
      <button class="button button--primary button--small" type="button" data-get-started-open data-apply-intent="apply">Apply</button>
    </div>
    <details class="site-menu" data-site-menu>
      <summary class="site-menu__toggle" aria-label="Menu">
        <svg class="site-menu__icon site-menu__icon--open" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M3 6h14M3 10h14M3 14h14" />
        </svg>
        <svg class="site-menu__icon site-menu__icon--close" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M5 5l10 10M15 5L5 15" />
        </svg>
      </summary>
      <nav class="site-menu__panel" aria-label="Site">
        {NAV_LINKS.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
        <a href="https://app.autoseo.run/app">Open workspace <span class="external-icon" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M5 11 11 5M5 5h6v6" /></svg></span></a>
        <button class="button button--primary button--small" type="button" data-get-started-open data-apply-intent="apply">Apply for early access</button>
      </nav>
    </details>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>("[data-site-menu]");

  if (menu) {
    menu.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a, button")) menu.open = false;
    });

    document.addEventListener("click", (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") menu.open = false;
    });
  }
</script>
